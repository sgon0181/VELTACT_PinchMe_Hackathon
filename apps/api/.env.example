NODE_ENV=development
PORT=4000
# Use a publicly reachable HTTPS origin when invitation links must open on a phone.
# The API serves supplier.html from this origin and embeds it in email/SMS messages.
WEB_ORIGIN=http://localhost:4000
# Canonical public origin for supplier claim and payment return links.
PUBLIC_BASE_URL=http://localhost:4000
API_PUBLIC_URL=http://localhost:4000

# Durable single-process marketplace state. Relative paths resolve from apps/api.
MARKETPLACE_DATA_FILE=.data/marketplace.json
# Versioned Find, Connect, Deploy state.
VELTACT_V2_DATA_FILE=.data/veltact-v2.json
# Durable staging account credentials. Sessions remain process-local.
ACCOUNT_DATA_FILE=.data/accounts.json
# Optional JSON array validated against the shared supplier catalog contract.
SUPPLIER_CATALOG_FILE=
# Production defaults to true. Development defaults to false for demo convenience.
BUYER_CAPABILITY_AUTH_REQUIRED=
API_RATE_LIMIT_MAX=300
AI_RATE_LIMIT_MAX=30

# Payment provider. Pinch remains the default. local_demo is an explicit
# development/test-only mode that creates no provider transaction or network call.
PAYMENT_PROVIDER=pinch
# Disclosed Veltact service-fee allocation in basis points. 500 = 5%.
VELTACT_SERVICE_FEE_BPS=500

# Supplier outreach delivery.
# EMAIL_PROVIDER supports local_demo, resend, or sendgrid.
# local_demo confirms the app flow in development/test but does not deliver external email.
# Resend and SendGrid require a verified sender accepted by the provider.
EMAIL_PROVIDER=local_demo
EMAIL_FROM=Veltact <opportunities@example.com>
RESEND_API_KEY=
SENDGRID_API_KEY=

# SMS_PROVIDER supports none, local_demo, or twilio.
# local_demo prepares the secure invitation without external delivery.
# Twilio expects E.164 numbers. Trial accounts may require a verified destination.
# Twilio WhatsApp uses the same Messages API and the mobile outreach contract slot.
SMS_PROVIDER=none
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_WHATSAPP_FROM=

# Demo destination overrides. Set these to a real inbox/phone because seeded contacts are placeholders.
SUPPLIER_OUTREACH_EMAIL_TO=
SUPPLIER_OUTREACH_SMS_TO=
SUPPLIER_OUTREACH_WHATSAPP_TO=

# Optional AI intake. If OPENAI_API_KEY is unset, the API uses the deterministic local demo adapter.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
# auto uses OpenAI when configured and deterministic fixtures otherwise.
VELTACT_RESEARCH_PROVIDER=auto
# Supplier discovery can use OpenAI web search, optional Perplexity Sonar, or fixtures.
VELTACT_DISCOVERY_PROVIDER=auto
PERPLEXITY_API_KEY=
# Optional secondary supplier discovery provider. Not required for the demo.
FIRECRAWL_API_KEY=

# Required only when PAYMENT_PROVIDER=pinch.
PINCH_CLIENT_ID=
PINCH_SECRET_KEY=
PINCH_AUTH_URL=
PINCH_API_BASE_URL=
PINCH_API_VERSION=
PINCH_RETURN_URL=http://localhost:4000/api/pinch/return
PINCH_WEBHOOK_SECRET=
