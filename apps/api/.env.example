NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:5173
API_PUBLIC_URL=http://localhost:4000

# Supplier outreach delivery.
# EMAIL_PROVIDER supports local_demo, resend, or sendgrid.
# local_demo only logs in development/test and fails in production.
EMAIL_PROVIDER=local_demo
EMAIL_FROM=Veltact <opportunities@example.com>
RESEND_API_KEY=
SENDGRID_API_KEY=

# SMS_PROVIDER supports none or twilio.
SMS_PROVIDER=none
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Optional demo overrides. Use these when seeded supplier contacts are placeholder domains/numbers.
SUPPLIER_OUTREACH_EMAIL_TO=
SUPPLIER_OUTREACH_SMS_TO=

PINCH_CLIENT_ID=
PINCH_SECRET_KEY=
PINCH_AUTH_URL=
PINCH_API_BASE_URL=
PINCH_API_VERSION=
PINCH_RETURN_URL=
PINCH_WEBHOOK_SECRET=
